# Environment Variables for OmniEnglish Frontier

# Database (PostgreSQL + pgvector)
POSTGRES_USER=omniuser
POSTGRES_PASSWORD=omnipassword
POSTGRES_DB=omnienglish_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://omniuser:omnipassword@localhost:5432/omnienglish_db
SYNC_DATABASE_URL=postgresql+psycopg2://omniuser:omnipassword@localhost:5432/omnienglish_db

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Security & JWT
SECRET_KEY=supersecret_omnienglish_jwt_key_32bytes_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200 # 30 days

# AI & LLM Services (Optional: fallback to local engine if empty)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/voice/ws
